# ==============================================================================
# SISTEM BOOKING LAPANGAN BADMINTON - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

APP_NAME="Nama GOR Badminton"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://namagor.com

# Zona Waktu Wajib: Asia/Jayapura (WIT)
GOR_TIMEZONE=Asia/Jayapura
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Koneksi Database MySQL Produksi
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_badminton_prod
DB_USERNAME=badminton_user
DB_PASSWORD=GantiDenganPasswordKuatDanAcak!2026

# Manajemen Sesi & Cookie Aman
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Parameter Operasional GOR (Bisa disesuaikan via config/gor.php atau /admin/pengaturan)
GOR_NAME="Nama GOR Badminton"
GOR_CITY="Jayapura"
GOR_HOLD_MINUTES=15
GOR_IDLE_TIMEOUT_MINUTES=60
GOR_PRICE_SINGLE=200000
GOR_PRICE_PACKAGE=600000
GOR_RENEW_NOTICE_REMAINING=1
GOR_LAST_DAY_NOTICE_HOUR=6

# Driver Gateway Pembayaran Produksi (Ganti ke 'midtrans', 'xendit', dll saat integrasi riil)
GOR_PAYMENT_DRIVER=simulated

# Kunci API Gateway Pembayaran (Bila menggunakan payment gateway pihak ketiga)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=true

# Pengaturan Mailer (Opsional, bawaan sistem menggunakan notifikasi database in-app)
MAIL_MAILER=log
